    "originKey": "field_supply_map.flu_vaccine_given",
    "platformVersion": 1,
    "kind": "field_supply_map",
    "body": {
      "name": "General / primary care: Flu vaccine given",
      "noteTypeKey": "general_primary_care",
      "path": "preventive.vaccine_status.flu",
      "when": {
        "equals": "given_today"
      },
