{
  "name": "exam_lymphatic",
  "version": 1,
  "sections": [
    {
      "id": "lymphatic",
      "title": "Lymphatic",
      "spec": "exam-lymphatic",
      "showWhen": { "field": "exam.systems", "is": "lymphatic" },
      "normal": true,
      "fields": [
        {
          "id": "nodes",
          "kind": "choice",
          "many": true,
          "label": "Nodes examined",
          "options": [
            { "code": "cervical", "label": "Cervical" },
            { "code": "supraclavicular", "label": "Supraclavicular" },
            { "code": "axillary", "label": "Axillary" },
            { "code": "inguinal", "label": "Inguinal" },
            { "code": "other", "label": "Other", "other": true }
          ]
        },
        {
          "id": "node_findings",
          "kind": "grid",
          "label": "Findings for each node group",
          "rows": { "pickedIn": "lymphatic.nodes" },
          "cell": {
            "id": "node",
            "kind": "group",
            "label": "Findings",
            "layout": "stack",
            "fields": [
              {
                "id": "findings",
                "kind": "choice",
                "many": true,
                "label": "Findings",
                "options": [
                  { "code": "not_enlarged", "label": "Not enlarged", "normal": true },
                  { "code": "enlarged", "label": "Enlarged" },
                  { "code": "tender", "label": "Tender" },
                  { "code": "non_tender", "label": "Non-tender" },
                  { "code": "mobile", "label": "Mobile" },
                  { "code": "fixed", "label": "Fixed" }
                ],
                "excludes": [
                  ["not_enlarged", "enlarged"],
                  ["tender", "non_tender"],
                  ["mobile", "fixed"]
                ]
              },
              {
                "id": "size",
                "kind": "number",
                "label": "Size",
                "min": 0.1,
                "max": 20,
                "decimals": 1,
                "unit": "cm",
                "altUnit": { "unit": "in", "perUnit": 2.54 },
                "showWhen": { "field": "./findings", "filled": true }
              }
            ]
          }
        }
      ]
    }
  ]
}
