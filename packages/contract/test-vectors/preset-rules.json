        "expected": {"stateAfter": "active", "versionAfter": 1, "customizedAfter": false}
      },
      {
        "name": "a new flag starts the same way",
        "input": {"act": "create", "kind": "flag", "state": null, "baseVersion": null, "currentVersion": null, "changedFixed": false, "sameBody": false, "referencedBy": {}, "archivedRefs": 0, "nameTaken": false, "updateOnOffer": false, "updateChangesFixed": false},
        "expected": {"stateAfter": "active", "versionAfter": 1, "customizedAfter": false}
      },
