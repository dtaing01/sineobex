{
  "note": "Hand-written (phase 4 design, lifecycle 3.12; the rules are 3.4, 3.6, 3.8, 3.9, 4.4, 5.3, 5.4 and 5.5). One list of cases per function. services/api/src/encounters/rules.ts and apps/mobile/lib/encounters/rules.dart must give every answer; the readers are services/api/test/encounter-rules.test.ts and apps/mobile/test/encounters/rules_test.dart. Each function is called with a case's input as its one argument. Times are ISO 8601 in UTC.",
  "cases": {
    "signoffEffect": [
      {
        "name": "a Non-Medical draft is completed",
        "input": {"noteStatus": "draft", "medicalNote": false, "act": "complete", "actsAsAuthor": true, "canSign": false, "needsAttestation": false, "hashMatches": true, "emptyDraft": false, "finishOk": true, "redFlagsDone": true},
        "expected": {"effect": "completed", "statusAfter": "completed", "attestationAfter": "not_needed"}
      },
      {
        "name": "a Medical draft sent as complete waits for a co-signer",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "complete", "actsAsAuthor": true, "canSign": false, "needsAttestation": true, "hashMatches": true, "emptyDraft": false, "finishOk": true, "redFlagsDone": true},
        "expected": {"effect": "completed", "statusAfter": "completed", "attestationAfter": "not_needed"}
      },
      {
        "name": "complete on a Medical draft never signs, even from someone who can sign",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "complete", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": false, "finishOk": true, "redFlagsDone": true},
        "expected": {"effect": "completed", "statusAfter": "completed", "attestationAfter": "not_needed"}
      },
      {
        "name": "an attending signs: signed, nothing held",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "sign", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": false, "finishOk": true, "redFlagsDone": true},
        "expected": {"effect": "signed", "statusAfter": "signed", "attestationAfter": "not_needed"}
      },
      {
        "name": "a resident, NP or PA signs: signed, waiting for attestation",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "sign", "actsAsAuthor": true, "canSign": true, "needsAttestation": true, "hashMatches": true, "emptyDraft": false, "finishOk": true, "redFlagsDone": true},
        "expected": {"effect": "signed", "statusAfter": "signed", "attestationAfter": "waiting"}
      },
      {
        "name": "sign from a credential that cannot sign is saved unsigned",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "sign", "actsAsAuthor": true, "canSign": false, "needsAttestation": false, "hashMatches": true, "emptyDraft": false, "finishOk": true, "redFlagsDone": true},
        "expected": {"effect": "saved_unsigned", "statusAfter": "completed", "attestationAfter": "not_needed"}
      },
      {
        "name": "saved unsigned waits for a co-signer, not for attestation",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "sign", "actsAsAuthor": true, "canSign": false, "needsAttestation": true, "hashMatches": true, "emptyDraft": false, "finishOk": true, "redFlagsDone": true},
        "expected": {"effect": "saved_unsigned", "statusAfter": "completed", "attestationAfter": "not_needed"}
      },
      {
        "name": "sign on a Non-Medical note is treated as complete",
        "input": {"noteStatus": "draft", "medicalNote": false, "act": "sign", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": false, "finishOk": true, "redFlagsDone": true},
        "expected": {"effect": "completed", "statusAfter": "completed", "attestationAfter": "not_needed"}
      },
      {
        "name": "a Non-Medical note is never signed, whatever the credential",
        "input": {"noteStatus": "draft", "medicalNote": false, "act": "sign", "actsAsAuthor": true, "canSign": true, "needsAttestation": true, "hashMatches": true, "emptyDraft": false, "finishOk": true, "redFlagsDone": true},
        "expected": {"effect": "completed", "statusAfter": "completed", "attestationAfter": "not_needed"}
      },
      {
        "name": "a Non-Medical note does not wait for the Red flags note",
        "input": {"noteStatus": "draft", "medicalNote": false, "act": "complete", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": false, "finishOk": true, "redFlagsDone": false},
        "expected": {"effect": "completed", "statusAfter": "completed", "attestationAfter": "not_needed"}
      },
      {
        "name": "sign: the hash does not match",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "sign", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": false, "emptyDraft": false, "finishOk": true, "redFlagsDone": true},
        "expected": {"refuse": "content_changed"}
      },
      {
        "name": "complete: the hash does not match",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "complete", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": false, "emptyDraft": false, "finishOk": true, "redFlagsDone": true},
        "expected": {"refuse": "content_changed"}
      },
      {
        "name": "a Non-Medical note whose hash does not match",
        "input": {"noteStatus": "draft", "medicalNote": false, "act": "complete", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": false, "emptyDraft": false, "finishOk": true, "redFlagsDone": true},
        "expected": {"refuse": "content_changed"}
      },
      {
        "name": "sign: the finish check fails",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "sign", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": false, "finishOk": false, "redFlagsDone": true},
        "expected": {"refuse": "incomplete"}
      },
      {
        "name": "complete on a Non-Medical note: the finish check fails",
        "input": {"noteStatus": "draft", "medicalNote": false, "act": "complete", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": false, "finishOk": false, "redFlagsDone": true},
        "expected": {"refuse": "incomplete"}
      },
      {
        "name": "sign on a Medical note before the Red flags note is finished",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "sign", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": false, "finishOk": true, "redFlagsDone": false},
        "expected": {"refuse": "red_flags_first"}
      },
      {
        "name": "complete on a Medical note before the Red flags note is finished",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "complete", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": false, "finishOk": true, "redFlagsDone": false},
        "expected": {"refuse": "red_flags_first"}
      },
      {
        "name": "the sender does not act as the author",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "sign", "actsAsAuthor": false, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": false, "finishOk": true, "redFlagsDone": true},
        "expected": {"effect": "none", "reason": "not_author"}
      },
      {
        "name": "complete from someone who does not act as the author",
        "input": {"noteStatus": "draft", "medicalNote": false, "act": "complete", "actsAsAuthor": false, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": false, "finishOk": true, "redFlagsDone": true},
        "expected": {"effect": "none", "reason": "not_author"}
      },
      {
        "name": "a second sign-off of a completed note changes nothing",
        "input": {"noteStatus": "completed", "medicalNote": true, "act": "sign", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": false, "finishOk": true, "redFlagsDone": true},
        "expected": {"effect": "none", "reason": "already_finished"}
      },
      {
        "name": "a second sign-off of a signed note changes nothing",
        "input": {"noteStatus": "signed", "medicalNote": true, "act": "sign", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": false, "finishOk": true, "redFlagsDone": true},
        "expected": {"effect": "none", "reason": "already_finished"}
      },
      {
        "name": "complete on a completed Non-Medical note changes nothing",
        "input": {"noteStatus": "completed", "medicalNote": false, "act": "complete", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": false, "finishOk": true, "redFlagsDone": true},
        "expected": {"effect": "none", "reason": "already_finished"}
      },
      {
        "name": "order 1 before 2: a finished note answers already_finished to someone who is not its author",
        "input": {"noteStatus": "completed", "medicalNote": true, "act": "sign", "actsAsAuthor": false, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": false, "finishOk": true, "redFlagsDone": true},
        "expected": {"effect": "none", "reason": "already_finished"}
      },
      {
        "name": "order 1 before 3: a finished note is not checked against the hash",
        "input": {"noteStatus": "signed", "medicalNote": true, "act": "sign", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": false, "emptyDraft": false, "finishOk": false, "redFlagsDone": false},
        "expected": {"effect": "none", "reason": "already_finished"}
      },
      {
        "name": "order 2 before 3: not the author, and the hash does not match",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "sign", "actsAsAuthor": false, "canSign": true, "needsAttestation": false, "hashMatches": false, "emptyDraft": false, "finishOk": true, "redFlagsDone": true},
        "expected": {"effect": "none", "reason": "not_author"}
      },
      {
        "name": "order 2 before 5: not the author, on a visit with no Red flags note",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "sign", "actsAsAuthor": false, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": false, "finishOk": true, "redFlagsDone": false},
        "expected": {"effect": "none", "reason": "not_author"}
      },
      {
        "name": "order 3 before 4: the hash does not match and the finish check fails",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "sign", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": false, "emptyDraft": false, "finishOk": false, "redFlagsDone": true},
        "expected": {"refuse": "content_changed"}
      },
      {
        "name": "order 3 before 5: the hash does not match and the Red flags note is missing",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "sign", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": false, "emptyDraft": false, "finishOk": true, "redFlagsDone": false},
        "expected": {"refuse": "content_changed"}
      },
      {
        "name": "order 4 before 5: the finish check fails and the Red flags note is missing",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "sign", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": false, "finishOk": false, "redFlagsDone": false},
        "expected": {"refuse": "incomplete"}
      },
      {
        "name": "order 5 before 8: Red flags missing, from a credential that cannot sign",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "sign", "actsAsAuthor": true, "canSign": false, "needsAttestation": false, "hashMatches": true, "emptyDraft": false, "finishOk": true, "redFlagsDone": false},
        "expected": {"refuse": "red_flags_first"}
      },
      {
        "name": "a draft with everything wrong answers the first check that applies",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "sign", "actsAsAuthor": false, "canSign": false, "needsAttestation": false, "hashMatches": false, "emptyDraft": false, "finishOk": false, "redFlagsDone": false},
        "expected": {"effect": "none", "reason": "not_author"}
      },
      {
        "name": "an empty draft completed changes nothing: it does not count, and there is nothing to fix",
        "input": {"noteStatus": "draft", "medicalNote": false, "act": "complete", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": true, "finishOk": true, "redFlagsDone": true},
        "expected": {"effect": "none", "reason": "empty"}
      },
      {
        "name": "an empty Medical draft signed changes nothing",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "sign", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": true, "finishOk": true, "redFlagsDone": true},
        "expected": {"effect": "none", "reason": "empty"}
      },
      {
        "name": "order empty before 4: an empty draft whose finish check fails is not refused",
        "input": {"noteStatus": "draft", "medicalNote": false, "act": "complete", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": true, "finishOk": false, "redFlagsDone": true},
        "expected": {"effect": "none", "reason": "empty"}
      },
      {
        "name": "order empty before 5: an empty Medical draft on a visit with no Red flags note is not refused",
        "input": {"noteStatus": "draft", "medicalNote": true, "act": "sign", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": true, "finishOk": true, "redFlagsDone": false},
        "expected": {"effect": "none", "reason": "empty"}
      },
      {
        "name": "order 3 before empty: an empty draft whose hash does not match is refused",
        "input": {"noteStatus": "draft", "medicalNote": false, "act": "complete", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": false, "emptyDraft": true, "finishOk": true, "redFlagsDone": true},
        "expected": {"refuse": "content_changed"}
      },
      {
        "name": "order 2 before empty: an empty draft from someone who does not act as the author",
        "input": {"noteStatus": "draft", "medicalNote": false, "act": "complete", "actsAsAuthor": false, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": true, "finishOk": true, "redFlagsDone": true},
        "expected": {"effect": "none", "reason": "not_author"}
      },
      {
        "name": "order 1 before empty: a finished note answers already_finished",
        "input": {"noteStatus": "completed", "medicalNote": false, "act": "complete", "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "hashMatches": true, "emptyDraft": true, "finishOk": true, "redFlagsDone": true},
        "expected": {"effect": "none", "reason": "already_finished"}
      }
    ],
    "reopenEffect": [
      {
        "name": "the author reopens a Medical note that waits for a co-signer",
        "input": {"noteStatus": "completed", "everSigned": false, "medicalNote": true, "actsAsAuthor": true},
        "expected": "apply"
      },
      {
        "name": "a draft is already a draft",
        "input": {"noteStatus": "draft", "everSigned": false, "medicalNote": true, "actsAsAuthor": true},
        "expected": "nothing"
      },
      {
        "name": "a draft is already a draft, whoever asks",
        "input": {"noteStatus": "draft", "everSigned": false, "medicalNote": true, "actsAsAuthor": false},
        "expected": "nothing"
      },
      {
        "name": "a Non-Medical draft is already a draft",
        "input": {"noteStatus": "draft", "everSigned": false, "medicalNote": false, "actsAsAuthor": true},
        "expected": "nothing"
      },
      {
        "name": "a signed note is never reopened",
        "input": {"noteStatus": "signed", "everSigned": true, "medicalNote": true, "actsAsAuthor": true},
        "expected": "keep_in_history"
      },
      {
        "name": "a signed note is never reopened, even if its first signature was not recorded",
        "input": {"noteStatus": "signed", "everSigned": false, "medicalNote": true, "actsAsAuthor": true},
        "expected": "keep_in_history"
      },
      {
        "name": "a note that was ever signed is never reopened: a co-signed note a student corrected",
        "input": {"noteStatus": "completed", "everSigned": true, "medicalNote": true, "actsAsAuthor": true},
        "expected": "keep_in_history"
      },
      {
        "name": "a completed Non-Medical note is final",
        "input": {"noteStatus": "completed", "everSigned": false, "medicalNote": false, "actsAsAuthor": true},
        "expected": "keep_in_history"
      },
      {
        "name": "someone else cannot reopen the note",
        "input": {"noteStatus": "completed", "everSigned": false, "medicalNote": true, "actsAsAuthor": false},
        "expected": "keep_in_history"
      },
      {
        "name": "order 1 before 2: a draft that was once signed is still nothing to reopen",
        "input": {"noteStatus": "draft", "everSigned": true, "medicalNote": true, "actsAsAuthor": true},
        "expected": "nothing"
      },
      {
        "name": "a signed note, asked by someone else",
        "input": {"noteStatus": "signed", "everSigned": true, "medicalNote": true, "actsAsAuthor": false},
        "expected": "keep_in_history"
      },
      {
        "name": "a completed Non-Medical note, asked by someone else",
        "input": {"noteStatus": "completed", "everSigned": false, "medicalNote": false, "actsAsAuthor": false},
        "expected": "keep_in_history"
      }
    ],
    "correctionEffect": [
      {
        "name": "a completed Non-Medical note stays completed",
        "input": {"noteStatus": "completed", "attestation": "not_needed", "correctorCanSign": false, "correctorNeedsAttestation": false},
        "expected": {"statusAfter": "completed", "attestationAfter": "not_needed", "clearSignoff": false}
      },
      {
        "name": "a note waiting for a co-signer stays waiting, corrected by a student",
        "input": {"noteStatus": "completed", "attestation": "not_needed", "correctorCanSign": false, "correctorNeedsAttestation": true},
        "expected": {"statusAfter": "completed", "attestationAfter": "not_needed", "clearSignoff": false}
      },
      {
        "name": "a completed note stays completed when an attending acts as its author",
        "input": {"noteStatus": "completed", "attestation": "not_needed", "correctorCanSign": true, "correctorNeedsAttestation": false},
        "expected": {"statusAfter": "completed", "attestationAfter": "not_needed", "clearSignoff": false}
      },
      {
        "name": "a completed note is not signed by a resident’s correction",
        "input": {"noteStatus": "completed", "attestation": "not_needed", "correctorCanSign": true, "correctorNeedsAttestation": true},
        "expected": {"statusAfter": "completed", "attestationAfter": "not_needed", "clearSignoff": false}
      },
      {
        "name": "an attending corrects their own signed note: unchanged",
        "input": {"noteStatus": "signed", "attestation": "not_needed", "correctorCanSign": true, "correctorNeedsAttestation": false},
        "expected": {"statusAfter": "signed", "attestationAfter": "not_needed", "clearSignoff": false}
      },
      {
        "name": "an attending corrects a note that waits for attestation: it still waits",
        "input": {"noteStatus": "signed", "attestation": "waiting", "correctorCanSign": true, "correctorNeedsAttestation": false},
        "expected": {"statusAfter": "signed", "attestationAfter": "waiting", "clearSignoff": false}
      },
      {
        "name": "an attending corrects an attested note: it stays attested",
        "input": {"noteStatus": "signed", "attestation": "attested", "correctorCanSign": true, "correctorNeedsAttestation": false},
        "expected": {"statusAfter": "signed", "attestationAfter": "attested", "clearSignoff": false}
      },
      {
        "name": "a resident corrects a note that waits: it waits",
        "input": {"noteStatus": "signed", "attestation": "waiting", "correctorCanSign": true, "correctorNeedsAttestation": true},
        "expected": {"statusAfter": "signed", "attestationAfter": "waiting", "clearSignoff": false}
      },
      {
        "name": "a resident corrects an attested note: it waits for attestation again",
        "input": {"noteStatus": "signed", "attestation": "attested", "correctorCanSign": true, "correctorNeedsAttestation": true},
        "expected": {"statusAfter": "signed", "attestationAfter": "waiting", "clearSignoff": false}
      },
      {
        "name": "a resident corrects a note signed with nothing held: it now waits",
        "input": {"noteStatus": "signed", "attestation": "not_needed", "correctorCanSign": true, "correctorNeedsAttestation": true},
        "expected": {"statusAfter": "signed", "attestationAfter": "waiting", "clearSignoff": false}
      },
      {
        "name": "a student corrects a co-signed note: it waits for a co-signer again",
        "input": {"noteStatus": "signed", "attestation": "not_needed", "correctorCanSign": false, "correctorNeedsAttestation": true},
        "expected": {"statusAfter": "completed", "attestationAfter": "not_needed", "clearSignoff": true}
      },
      {
        "name": "a student corrects a co-signed note that waited for attestation",
        "input": {"noteStatus": "signed", "attestation": "waiting", "correctorCanSign": false, "correctorNeedsAttestation": true},
        "expected": {"statusAfter": "completed", "attestationAfter": "not_needed", "clearSignoff": true}
      },
      {
        "name": "a student corrects a co-signed and attested note",
        "input": {"noteStatus": "signed", "attestation": "attested", "correctorCanSign": false, "correctorNeedsAttestation": true},
        "expected": {"statusAfter": "completed", "attestationAfter": "not_needed", "clearSignoff": true}
      },
      {
        "name": "order 2 before 3: a corrector who cannot sign, whatever else their credential says",
        "input": {"noteStatus": "signed", "attestation": "attested", "correctorCanSign": false, "correctorNeedsAttestation": false},
        "expected": {"statusAfter": "completed", "attestationAfter": "not_needed", "clearSignoff": true}
      }
    ],
    "cosignEffect": [
      {
        "name": "an attending co-signs: signed, nothing held",
        "input": {"noteStatus": "completed", "medicalNote": true, "actsAsAuthor": false, "canSign": true, "needsAttestation": false, "seesAllThatCounts": true, "hashMatches": true},
        "expected": {"statusAfter": "signed", "attestationAfter": "not_needed"}
      },
      {
        "name": "a resident, NP or PA co-signs: signed, waiting for attestation",
        "input": {"noteStatus": "completed", "medicalNote": true, "actsAsAuthor": false, "canSign": true, "needsAttestation": true, "seesAllThatCounts": true, "hashMatches": true},
        "expected": {"statusAfter": "signed", "attestationAfter": "waiting"}
      },
      {
        "name": "a draft does not wait for a co-signer",
        "input": {"noteStatus": "draft", "medicalNote": true, "actsAsAuthor": false, "canSign": true, "needsAttestation": false, "seesAllThatCounts": true, "hashMatches": true},
        "expected": {"refuse": "not_waiting"}
      },
      {
        "name": "a signed note does not wait for a co-signer",
        "input": {"noteStatus": "signed", "medicalNote": true, "actsAsAuthor": false, "canSign": true, "needsAttestation": false, "seesAllThatCounts": true, "hashMatches": true},
        "expected": {"refuse": "not_waiting"}
      },
      {
        "name": "a completed Non-Medical note is never co-signed",
        "input": {"noteStatus": "completed", "medicalNote": false, "actsAsAuthor": false, "canSign": true, "needsAttestation": false, "seesAllThatCounts": true, "hashMatches": true},
        "expected": {"refuse": "not_waiting"}
      },
      {
        "name": "nobody co-signs a note they act as the author of",
        "input": {"noteStatus": "completed", "medicalNote": true, "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "seesAllThatCounts": true, "hashMatches": true},
        "expected": {"refuse": "is_author"}
      },
      {
        "name": "a credential that cannot sign cannot co-sign",
        "input": {"noteStatus": "completed", "medicalNote": true, "actsAsAuthor": false, "canSign": false, "needsAttestation": true, "seesAllThatCounts": true, "hashMatches": true},
        "expected": {"refuse": "cannot_sign"}
      },
      {
        "name": "a co-signer must see every answer that counts",
        "input": {"noteStatus": "completed", "medicalNote": true, "actsAsAuthor": false, "canSign": true, "needsAttestation": false, "seesAllThatCounts": false, "hashMatches": true},
        "expected": {"refuse": "cannot_see_all"}
      },
      {
        "name": "the note changed since the co-signer read it",
        "input": {"noteStatus": "completed", "medicalNote": true, "actsAsAuthor": false, "canSign": true, "needsAttestation": false, "seesAllThatCounts": true, "hashMatches": false},
        "expected": {"refuse": "content_changed"}
      },
      {
        "name": "order: not waiting before is_author",
        "input": {"noteStatus": "draft", "medicalNote": true, "actsAsAuthor": true, "canSign": true, "needsAttestation": false, "seesAllThatCounts": true, "hashMatches": true},
        "expected": {"refuse": "not_waiting"}
      },
      {
        "name": "order: is_author before cannot_sign",
        "input": {"noteStatus": "completed", "medicalNote": true, "actsAsAuthor": true, "canSign": false, "needsAttestation": false, "seesAllThatCounts": true, "hashMatches": true},
