  "steps": [
    {
      "n": 1,
      "online": false,
      "by": "resident",
      "story": "Offline. The resident starts a Medical encounter for the patient, at encounter.locationText, and adds General / primary care, Wound care and Social needs, in that order. The app adds the Red flags and disposition note by itself, with General / primary care, in the same transaction.",
      "expect": {
        "phone": { "encounters": 1, "notes": 4, "noteStatus": "draft", "sent": 0 }
      }
    },
    {
      "n": 2,
      "online": false,
      "by": "resident",
      "story": "They fill in each note's answers and press Save & Close. The app is killed and started again, still offline.",
      "expect": {
        "phone": { "encounters": 1, "notes": 4, "noteStatus": "draft", "answers": "answers", "notesToFinish": 4, "sent": 0 }
      }
    },
    {
      "n": 3,
      "online": true,
      "by": "resident",
      "story": "The phone reconnects.",
      "expect": {
        "receipts": { "status": "accepted", "hashConfirmed": true },
        "server": {
          "encounters": 1,
          "encounterStatus": "draft",
          "notes": 4,
          "noteStatus": "draft",
          "attestation": "not_needed",
          "answers": "answers",
          "notesToFinish": 4
        },
        "phone": { "encounters": 1, "notes": 4, "noteStatus": "draft" }
      }
    },
    {
      "n": 4,
      "online": false,
      "by": "resident",
      "story": "Offline again, later. They open the visit from Notes to finish, answer the red-flag question (answersAtStep4), write the assessment and press Complete and sign.",
      "expect": {
        "phone": {
          "button": "Complete and sign",
          "outbox": [
            { "note": "redFlags", "act": "sign" },
            { "note": "general", "act": "sign" },
            { "note": "wound", "act": "sign" },
            { "note": "social", "act": "complete" }
          ],
          "readOnly": true,
          "opens": "chart",
          "visitLabel": "Waiting to send"
        }
      }
    },
    {
      "n": 5,
      "online": true,
      "by": "resident",
      "story": "The phone reconnects.",
      "expect": {
        "receipts": { "status": "accepted", "hashConfirmed": true },
        "server": {
          "signoffs": 4,
          "effects": { "signed": 3, "completed": 1 },
          "notes": "afterStep5",
          "encounterStatus": "signed",
          "events": { "note.signed": 3, "note.completed": 1 },
          "eachEventInItsChangeTransaction": true
        }
      }
    },
    {
      "n": 6,
      "online": true,
      "by": "resident",
      "story": "The phone's sync finishes.",
      "expect": {
        "phone": { "encounters": 0, "notes": 0, "notesToFinish": 0 },
        "server": { "notesToFinish": 0 }
      }
    },
    {
      "n": 7,
      "online": true,
      "by": "attending",
      "story": "An attending, online, opens the attestation queue and attests the visit in one action.",
      "expect": {
        "server": {
          "queueBefore": { "visits": 1, "notes": ["general", "redFlags", "wound"] },
          "attest": { "status": 200, "notes": ["general", "redFlags", "wound"] },
          "queueAfter": { "visits": 0 },
          "attestations": 3,
          "notes": "afterStep7",
          "encounterStatus": "signed",
          "events": { "attestation_queue.viewed": 1, "note.attested": 3 },
          "notices": { "resident": { "note_attested": 1 } }
        }
      }
    }
  ],

