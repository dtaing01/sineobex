<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: exclude everything from cloud backup and device-to-device transfer. Patient data
     lives only in the encrypted local database and must never leave the phone except through sync. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
